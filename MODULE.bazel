module(
    name = "park",
    version = "0.0.1",
    repo_name = "park",
)

bazel_dep(name = "rules_cc", version = "0.1.2")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.5.0-rc4")
bazel_dep(name = "googletest", version = "1.14.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.2.0.2")
bazel_dep(name = "aspect_rules_lint", version = "1.4.4")
bazel_dep(name = "rules_multitool", version = "1.5.0")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
use_repo(multitool, "multitool")

external_dependencies = use_extension("//:extensions.bzl", "external_dependencies")
use_repo(external_dependencies, "unity")
